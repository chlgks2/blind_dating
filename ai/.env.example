# ===== Django 백엔드 (워커가 폴링할 대상) =====
# GPU 머신에서 접근 가능한 주소를 넣는다.
BACKEND_URL=http://127.0.0.1:8000

# ===== 로컬 ComfyUI HTTP API =====
COMFYUI_URL=http://127.0.0.1:8188

# ===== 워커 인증 토큰 (Django 워커 엔드포인트 보호용) =====
WORKER_TOKEN=

# ===== 타이밍 =====
POLL_INTERVAL=3         # 작업이 없을 때 다음 폴링까지 대기(초)
ERROR_BACKOFF=5         # 폴링 실패 후 재시도 대기(초)
GENERATE_TIMEOUT=600    # 생성 1건 최대 대기(초). 초과 시 실패 처리
HTTP_TIMEOUT=60         # HTTP 요청 타임아웃(초)

# ===== 워크플로우 =====
WORKFLOW_DIR=./workflows
